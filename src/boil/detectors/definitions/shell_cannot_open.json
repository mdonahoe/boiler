{
  "name": "ShellCannotOpenDetector",
  "priority": 100,
  "patterns": {
    "missing_file": "(?:/bin/)?sh:\\s*\\d+:\\s*cannot open\\s+(?P<file_path>[^\\s:]+):\\s*No such file"
  },
  "examples": [
    {
      "name": "missing_file_open",
      "input": "sh: 1: cannot open config.sh: No such file",
      "clue_type": "missing_file",
      "context": {
        "file_path": "config.sh"
      }
    },
    {
      "name": "missing_file_bin_sh",
      "input": "/bin/sh: 0: cannot open ./psize.sh: No such file",
      "clue_type": "missing_file",
      "context": {
        "file_path": "./psize.sh"
      }
    }
  ]
}
