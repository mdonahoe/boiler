{
  "detectors": [
    {
      "name": "CannotOpenFileDetector",
      "priority": 100,
      "patterns": {
        "missing_file": "[Ee]rror:?\\s+Cannot open file\\s+['\"](?P<file_path>[^'\"]+)['\"]"
      },
      "examples": [
        {
          "name": "cannot_open_single_quotes",
          "input": "Error: Cannot open file 'config.json'",
          "clue_type": "missing_file",
          "context": {"file_path": "config.json"}
        },
        {
          "name": "cannot_open_double_quotes",
          "input": "error Cannot open file \"main.py\"",
          "clue_type": "missing_file",
          "context": {"file_path": "main.py"}
        }
      ]
    },
    {
      "name": "CatNoSuchFileDetector",
      "priority": 100,
      "patterns": {
        "missing_file": "cat:\\s*(?P<file_path>[^\\s:]+):\\s*No such file or directory"
      },
      "examples": [
        {
          "name": "cat_missing_makefile",
          "input": "cat: Makefile.in: No such file or directory",
          "clue_type": "missing_file",
          "context": {"file_path": "Makefile.in"}
        },
        {
          "name": "cat_missing_config",
          "input": "cat: config.txt: No such file or directory",
          "clue_type": "missing_file",
          "context": {"file_path": "config.txt"}
        }
      ]
    },
    {
      "name": "CCompilationErrorDetector",
      "priority": 100,
      "patterns": {
        "missing_file": "fatal error:\\s+\\.?/?(?P<file_path>[^\\s:]+):\\s+No such file or directory"
      },
      "examples": [
        {
          "name": "fatal_error_header",
          "input": "/tmp/ex_bar.c:82:10: fatal error: ex.h: No such file or directory",
          "clue_type": "missing_file",
          "context": {"file_path": "ex.h"}
        },
        {
          "name": "fatal_error_relative_path",
          "input": "lib/src/node.c:2:10: fatal error: ./point.h: No such file or directory",
          "clue_type": "missing_file",
          "context": {"file_path": "point.h"}
        }
      ]
    },
    {
      "name": "CImplicitDeclarationDetector",
      "priority": 100,
      "patterns": {
        "missing_c_include": "(?P<file_path>[a-zA-Z0-9_./\\-]+\\.c):\\d+:\\d+:\\s+(?:error|warning):\\s+implicit declaration of function\\s+[''](?P<function_name>[^'']+)[''].*?note:\\s+include\\s+['']<(?P<suggested_include>[^>]+)>['']",
        "missing_c_function": "(?P<file_path>[a-zA-Z0-9_./\\-]+\\.c):(?P<line_number>\\d+):\\d+:\\s+(?:error|warning):\\s+implicit declaration of function\\s+[''](?P<function_name>[^'']+)['']"
      },
      "examples": [
        {
          "name": "implicit_declaration_with_note",
          "input": "main.c:10:5: warning: implicit declaration of function 'printf' [-Wimplicit-function-declaration] note: include '<stdio.h>'",
          "clue_type": "missing_c_include",
          "context": {
            "file_path": "main.c",
            "function_name": "printf",
            "suggested_include": "stdio.h"
          }
        },
        {
          "name": "implicit_declaration_simple",
          "input": "test.c:42:8: error: implicit declaration of function 'custom_func'",
          "clue_type": "missing_c_function",
          "context": {
            "file_path": "test.c",
            "line_number": "42",
            "function_name": "custom_func"
          }
        }
      ]
    },
    {
      "name": "CIncompleteTypeDetector",
      "priority": 100,
      "patterns": {
        "missing_c_include": "(?P<file_path>[a-zA-Z0-9_./\\-]+\\.c):\\d+:\\d+:[^\\n]*error:[^\\n]*(?:has incomplete type|storage size).*struct\\s+(?P<struct_name>termios|winsize|stat|tm|sigaction|dirent)"
      },
      "examples": [
        {
          "name": "incomplete_type_termios",
          "input": "term.c:15:3: error: variable has incomplete type 'struct termios'",
          "clue_type": "missing_c_include",
          "context": {
            "file_path": "term.c",
            "struct_name": "termios"
          }
        },
        {
          "name": "storage_size_winsize",
          "input": "window.c:8:12: error: storage size of 'ws' isn't known struct winsize",
          "clue_type": "missing_c_include",
          "context": {
            "file_path": "window.c",
            "struct_name": "winsize"
          }
        }
      ]
    },
    {
      "name": "CLinkerErrorDetector",
      "priority": 100,
      "patterns": {
        "linker_undefined_symbols": "undefined reference to [`'](?P<symbol>[^'`]+)[`']",
        "missing_file": "/usr/bin/ld:.*?cannot find\\s+(?P<file_path>[^\\s:]+):\\s+No such file or directory"
      },
      "examples": [
        {
          "name": "undefined_reference_backtick",
          "input": "undefined reference to `ts_parser_new'",
          "clue_type": "linker_undefined_symbols",
          "context": {"symbol": "ts_parser_new"}
        },
        {
          "name": "undefined_reference_quote",
          "input": "tree_print.c:(.text+0x137): undefined reference to 'ts_node_start_byte'",
          "clue_type": "linker_undefined_symbols",
          "context": {"symbol": "ts_node_start_byte"}
        },
        {
          "name": "ld_cannot_find",
          "input": "/usr/bin/ld: cannot find exrecover.o: No such file or directory",
          "clue_type": "missing_file",
          "context": {"file_path": "exrecover.o"}
        }
      ]
    },
    {
      "name": "CSyntaxErrorDetector",
      "priority": 100,
      "patterns": {
        "c_syntax_error_in_header": "(?P<file_path>[^\\s:]+\\.h):(?P<line_number>\\d+):\\d+:\\s+error:\\s+expected\\s+.+?\\s+before\\s+[''](?P<unexpected_token>[^'']+)['']",
        "c_syntax_error_in_source": "(?P<file_path>[^\\s:]+\\.c):(?P<line_number>\\d+):\\d+:\\s+error:\\s+expected\\s+.+?\\s+before\\s+[''](?P<unexpected_token>[^'']+)['']"
      },
      "examples": [
        {
          "name": "syntax_error_header",
          "input": "include/api.h:15:1: error: expected ';' before 'typedef'",
          "clue_type": "c_syntax_error_in_header",
          "context": {
            "file_path": "include/api.h",
            "line_number": "15",
            "unexpected_token": "typedef"
          }
        },
        {
          "name": "syntax_error_source",
          "input": "main.c:42:5: error: expected declaration before 'return'",
          "clue_type": "c_syntax_error_in_source",
          "context": {
            "file_path": "main.c",
            "line_number": "42",
            "unexpected_token": "return"
          }
        }
      ]
    },
    {
      "name": "CUndeclaredIdentifierDetector",
      "priority": 100,
      "patterns": {
        "missing_c_include": "(?P<file_path>[a-zA-Z0-9_./\\-]+\\.c):\\d+:\\d+:[^\\n]*undeclared.*note:.*is defined in header\\s+['']<(?P<suggested_include>[^>]+)>['']",
        "missing_c_function": "(?P<file_path>[a-zA-Z0-9_./\\-]+\\.c):(?P<line_number>\\d+):\\d+:\\s+error:\\s+[''](?P<identifier>[^'']+)['']\\s+undeclared\\s+\\(first use"
      },
      "examples": [
        {
          "name": "undeclared_with_header_note",
          "input": "main.c:5:12: 'NULL' undeclared here (not in a function); note: 'NULL' is defined in header '<stddef.h>'",
          "clue_type": "missing_c_include",
          "context": {
            "file_path": "main.c",
            "suggested_include": "stddef.h"
          }
        },
        {
          "name": "undeclared_first_use",
          "input": "test.c:20:10: error: 'my_var' undeclared (first use",
          "clue_type": "missing_c_function",
          "context": {
            "file_path": "test.c",
            "line_number": "20",
            "identifier": "my_var"
          }
        }
      ]
    },
    {
      "name": "CUnknownTypeDetector",
      "priority": 100,
      "patterns": {
        "unknown_type_name": "(?P<file_path>[a-zA-Z0-9_./\\-]+\\.c):(?P<line_number>\\d+):\\d+:\\s+error:\\s+unknown type name\\s+[''](?P<type_name>[^'']+)['']"
      },
      "examples": [
        {
          "name": "unknown_type_size_t",
          "input": "utils.c:8:1: error: unknown type name 'size_t'",
          "clue_type": "unknown_type_name",
          "context": {
            "file_path": "utils.c",
            "line_number": "8",
            "type_name": "size_t"
          }
        }
      ]
    },
    {
      "name": "DiffNoSuchFileDetector",
      "priority": 100,
      "patterns": {
        "missing_file": "diff:\\s*(?P<file_path>[^\\s:]+):\\s*No such file or directory"
      },
      "examples": [
        {
          "name": "diff_missing_file",
          "input": "diff: expected.txt: No such file or directory",
          "clue_type": "missing_file",
          "context": {"file_path": "expected.txt"}
        }
      ]
    },
    {
      "name": "FileNotFoundDetector",
      "priority": 100,
      "patterns": {
        "missing_file": "FileNotFoundError:.*?No such file or directory:\\s*['\"](?P<file_path>[^'\"]+)['\"]",
        "missing_file_simple": "FileNotFoundError:\\s*(?P<file_path>[^\\s:]+)"
      },
      "examples": [
        {
          "name": "python_file_not_found",
          "input": "FileNotFoundError: [Errno 2] No such file or directory: './test.sh'",
          "clue_type": "missing_file",
          "context": {"file_path": "./test.sh"}
        },
        {
          "name": "python_file_not_found_simple",
          "input": "FileNotFoundError: ./configure",
          "clue_type": "missing_file_simple",
          "context": {"file_path": "./configure"}
        }
      ]
    },
    {
      "name": "FopenNoSuchFileDetector",
      "priority": 100,
      "patterns": {
        "missing_file": "fopen:\\s+(?P<file_path>[^\\s:]+?):\\s*No such file or directory",
        "missing_file_assertion": "AssertionError:\\s*['\"](?P<file_path>[^'\"]+\\.(?:py|txt|md|c|h|cpp|hpp|json|yaml|yml|sh|rs|go|java|js|ts|html|css|xml|sql))['\"].*fopen:\\s*No such file or directory"
      },
      "examples": [
        {
          "name": "fopen_missing_file",
          "input": "fopen: config.txt: No such file or directory",
          "clue_type": "missing_file",
          "context": {"file_path": "config.txt"}
        },
        {
          "name": "fopen_assertion",
          "input": "AssertionError: \"test.py\" something something fopen: No such file or directory",
          "clue_type": "missing_file_assertion",
          "context": {"file_path": "test.py"}
        }
      ]
    },
    {
      "name": "MakeEnteringDirectoryDetector",
      "priority": 100,
      "patterns": {
        "make_enter_directory": "make(?:\\[\\d+\\])?: Entering directory '(?P<directory>[^']+)'"
      },
      "examples": [
        {
          "name": "make_entering_simple",
          "input": "make: Entering directory '/home/user/project'",
          "clue_type": "make_enter_directory",
          "context": {"directory": "/home/user/project"}
        },
        {
          "name": "make_entering_with_level",
          "input": "make[1]: Entering directory '/tmp/build'",
          "clue_type": "make_enter_directory",
          "context": {"directory": "/tmp/build"}
        }
      ]
    },
    {
      "name": "MakeGlobPatternErrorDetector",
      "priority": 100,
      "patterns": {
        "missing_file": "make(?:\\[\\d+\\])?: \\*\\*\\* (?P<file_path>[^:]+):\\s+No such file or directory\\.\\s+Stop\\."
      },
      "examples": [
        {
          "name": "make_glob_missing",
          "input": "make: *** Makefile.inc: No such file or directory.  Stop.",
          "clue_type": "missing_file",
          "context": {"file_path": "Makefile.inc"}
        }
      ]
    },
    {
      "name": "MakeMissingTargetDetector",
      "priority": 100,
      "patterns": {
        "make_missing_target": "No rule to make target '(?P<target>[^']+)', needed by '(?P<needed_by>[^']+)'"
      },
      "examples": [
        {
          "name": "make_missing_target",
          "input": "No rule to make target 'utils.o', needed by 'main'",
          "clue_type": "make_missing_target",
          "context": {
            "target": "utils.o",
            "needed_by": "main"
          }
        }
      ]
    },
    {
      "name": "MakeNoRuleDetector",
      "priority": 100,
      "patterns": {
        "make_no_rule": "make(?:\\[\\d+\\])?: \\*\\*\\* No rule to make target '(?P<target>[^']+)'\\.\\s+Stop\\."
      },
      "examples": [
        {
          "name": "make_no_rule",
          "input": "make: *** No rule to make target 'test'.  Stop.",
          "clue_type": "make_no_rule",
          "context": {"target": "test"}
        },
        {
          "name": "make_no_rule_with_level",
          "input": "make[2]: *** No rule to make target 'build'.  Stop.",
          "clue_type": "make_no_rule",
          "context": {"target": "build"}
        }
      ]
    },
    {
      "name": "PermissionDeniedDetector",
      "priority": 100,
      "patterns": {
        "py_permission_denied": "Permission denied:\\s*['\"]?(?P<file_path>[^'\"]+)['\"]?",
        "sh_permission_denied": ":\\s*(?P<file_path>[^:]+):\\s*Permission denied"
      },
      "examples": [
        {
          "name": "python_permission_denied",
          "input": "Permission denied: '/etc/passwd'",
          "clue_type": "py_permission_denied",
          "context": {"file_path": "/etc/passwd"}
        },
        {
          "name": "shell_permission_denied",
          "input": "bash: /root/script.sh: Permission denied",
          "clue_type": "sh_permission_denied",
          "context": {"file_path": "/root/script.sh"}
        }
      ]
    },
    {
      "name": "PythonNameErrorDetector",
      "priority": 100,
      "patterns": {
        "python_name_error": "File \"(?P<file_path>[^\"]+\\.py)\", line (?P<line_number>\\d+),.*?NameError: (?:global )?name '(?P<undefined_name>\\w+)' is not defined"
      },
      "examples": [
        {
          "name": "python_name_error",
          "input": "File \"test.py\", line 10, in main NameError: name 'undefined_var' is not defined",
          "clue_type": "python_name_error",
          "context": {
            "file_path": "test.py",
            "line_number": "10",
            "undefined_name": "undefined_var"
          }
        }
      ]
    },
    {
      "name": "ShellCannotOpenDetector",
      "priority": 100,
      "patterns": {
        "missing_file": "sh:\\s*\\d+:\\s*cannot open\\s+(?P<file_path>[^\\s:]+):\\s*No such file"
      },
      "examples": [
        {
          "name": "shell_cannot_open",
          "input": "sh: 1: cannot open config.sh: No such file",
          "clue_type": "missing_file",
          "context": {"file_path": "config.sh"}
        }
      ]
    },
    {
      "name": "ShellCommandNotFoundDetector",
      "priority": 100,
      "patterns": {
        "missing_file": ":\\s*line\\s+\\d+:\\s*\\.?/?(?P<file_path>[^\\s:]+):\\s*No such file or directory",
        "missing_file_not_found": ":\\s*\\d+:\\s*\\.?/?(?P<file_path>[^\\s:]+):\\s*not found"
      },
      "examples": [
        {
          "name": "shell_no_such_file",
          "input": "bash: line 5: ./run.sh: No such file or directory",
          "clue_type": "missing_file",
          "context": {"file_path": "run.sh"}
        },
        {
          "name": "shell_not_found",
          "input": "sh: 1: ./script: not found",
          "clue_type": "missing_file_not_found",
          "context": {"file_path": "script"}
        }
      ]
    },
    {
      "name": "TestFailureDetector",
      "priority": 100,
      "patterns": {
        "test_failure": "File\\s+['\"](?P<test_file>[^'\"]+\\.py)['\"]\\s*,\\s+line\\s+(?P<line_number>\\d+),\\s+in\\s+(?P<test_name>\\w+)",
        "test_assertion_with_filename": "AssertionError:\\s*['\"](?P<suspected_file>[^'\"]+\\.(?:py|txt|md|c|h|cpp|hpp|json|yaml|yml|sh))['\"].*not found",
        "c_test_failure": "(?P<test_file>[^\\s:]+\\.c):(?P<line_number>\\d+):\\s*(?P<test_name>\\w+):\\s*Assertion\\s*[`'](?P<assertion>[^'`]+)[`']\\s*failed",
        "test_docstring_with_missing_file": "(?s)Test that[^\\n]*(?:can open|open)\\s+(?P<suspected_file>(?:README\\.md|[a-zA-Z0-9_-]+\\.(?:c|h|cpp|hpp|py|txt|md|json|yaml|yml|sh|rs|go|java|js|ts))).*?fopen:\\s*No such file or directory"
      },
      "examples": [
        {
          "name": "python_test_failure",
          "input": "File \"/path/to/test_dim.py\", line 235, in test_open_readme",
          "clue_type": "test_failure",
          "context": {
            "test_file": "/path/to/test_dim.py",
            "line_number": "235",
            "test_name": "test_open_readme"
          }
        },
        {
          "name": "assertion_with_filename",
          "input": "AssertionError: 'hello_world.txt' not found",
          "clue_type": "test_assertion_with_filename",
          "context": {"suspected_file": "hello_world.txt"}
        },
        {
          "name": "c_test_failure",
          "input": "test_runner.c:42: test_addition: Assertion `result == 5` failed",
          "clue_type": "c_test_failure",
          "context": {
            "test_file": "test_runner.c",
            "line_number": "42",
            "test_name": "test_addition",
            "assertion": "result == 5"
          }
        },
        {
          "name": "test_docstring_with_missing_file",
          "input": "Test that dim can open README.md and display its first line.\n----------------------------------------------------------------------\nTraceback (most recent call last):\n  File \"/tmp/test_dim.py\", line 235, in test_open_readme\n    self.assertIn(\"dim\", result.output)\nAssertionError: 'dim' not found in 'fopen: No such file or directory'",
          "clue_type": "test_docstring_with_missing_file",
          "context": {"suspected_file": "README.md"}
        }
      ]
    }
  ]
}
